# Used for local development (`expo start`). EAS builds instead pull these
# from the per-profile `env` blocks in eas.json (development/preview/production),
# each pointing at its own Supabase project.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
